{
  "name": "classeur",
  "private": true,
  "version": "0.1.0",
  "description": "Classeur : suivi de collection Pokémon (cartes + scellés) avec cote Cardmarket, graphiques et scan. Web app installable, sans pub ni limite.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:tel": "vite --host",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icones": "pwa-assets-generator --preset minimal-2023 public/icons/icone.svg",
    "donnees": "node scripts/donnees/construire.ts",
    "donnees:amorcer": "node scripts/donnees/amorcer-wayback.ts",
    "donnees:verifier": "node scripts/donnees/verifier.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-window": "^7.4.1"
  }
}
